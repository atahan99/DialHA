wifi_ssid: "your-ssid"
wifi_password: "your-password"

# openssl rand -base64 32
api_encryption_key: "REPLACE_WITH_BASE64_32_BYTE_KEY"

ota_password: "pick-a-strong-ota-password"

# Fallback AP password (used only when Settings → AP is ON)
ap_password: "m5dial-setup"

# IANA timezone for the clock / RTC (e.g. Europe/Istanbul)
timezone: "Europe/Istanbul"
# Keep packages/entities.yaml home_utc_offset in sync (Europe/Istanbul → "3")

# Open-Meteo weather for the same place as `timezone` — no API key needed.
# Two decimals is plenty (~1 km) and keeps your exact address out of the config.
latitude: "41.01"
longitude: "28.98"
weather_place: "ISTANBUL"
