# Personal build only (m5dial.yaml). dialha.factory.yaml reads no secrets.
wifi_ssid: "your-ssid"
wifi_password: "your-password"

# openssl rand -base64 32
api_encryption_key: "REPLACE_WITH_BASE64_32_BYTE_KEY"

ota_password: "pick-a-strong-ota-password"

# Fallback AP password, used only when Settings → AP is ON. Pick your own: the
# placeholder is public, so anyone reading this repo would know it.
ap_password: "CHANGE-ME"
